# Copie ce fichier en .env et adapte.
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Alertes e-mail (sans EMAIL_HOST, les e-mails s'affichent dans la console)
# Exemple Gmail : utiliser un « mot de passe d'application »
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=toi@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=TGV MAX Explorer <toi@gmail.com>

# Correspondances : temps en gare (minutes)
# CONNECTION_MIN_MINUTES=20
# CONNECTION_MAX_MINUTES=120
